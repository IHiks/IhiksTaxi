<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IhiksTaxi.UI"
             x:Class="IhiksTaxi.UI.MainPage"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- верхняя плашка с логотипом -->
        <Grid Grid.Row="0" Padding="24,16" BackgroundColor="{StaticResource HeaderBackground}"
              ColumnDefinitions="Auto,*">
            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <Label Text="IHIKS" Style="{StaticResource LogoOrange}" />
                <Label Text="ТАКСИ" Style="{StaticResource LogoDark}" />
            </HorizontalStackLayout>
            <Label Grid.Column="1" Text="Система заказа такси"
                   Style="{StaticResource MutedLabel}"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   IsVisible="{Binding ShowSubtitle}" />
        </Grid>
        <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1"
                 Color="{StaticResource StrokeColor}" />

        <!-- рабочая область -->
        <Grid Grid.Row="1">

            <!-- раздел «Заказать» -->
            <Grid IsVisible="{Binding ShowOrder}"
                  Margin="{Binding ContentMargin}"
                  RowDefinitions="Auto,*,Auto" RowSpacing="12">

                <Label Grid.Row="0" Text="Заказать поездку" Style="{StaticResource SectionTitle}" />

                <Grid Grid.Row="1" RowDefinitions="Auto,*" ColumnDefinitions="*,*"
                      ColumnSpacing="{Binding OrderColumnSpacing}">

                    <!-- карта видна всё время работы с заказом -->
                    <Border Grid.Row="{Binding OrderMapRow}"
                            Grid.Column="{Binding OrderMapColumn}"
                            Grid.RowSpan="{Binding OrderMapRowSpan}"
                            Grid.ColumnSpan="{Binding OrderMapColumnSpan}"
                            Style="{StaticResource Card}" Padding="0"
                            VerticalOptions="Fill"
                            IsVisible="{Binding Order.HasMap}">
                        <Grid>
                            <WebView x:Name="MapWebView" Source="{Binding Order.MapSource}"
                                     HorizontalOptions="Fill" VerticalOptions="Fill" />
                            <Border Margin="12" Padding="8,6"
                                    HorizontalOptions="Start" VerticalOptions="End"
                                    BackgroundColor="{StaticResource SoftBlue}" Stroke="{StaticResource StrokeColor}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                    IsVisible="{Binding Order.MapNote, Converter={StaticResource IsNotEmptyConverter}}">
                                <Label Text="{Binding Order.MapNote}" Style="{StaticResource MutedLabel}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- форма заказа -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="{Binding OrderPanelColumn}"
                                         Grid.RowSpan="{Binding OrderPanelRowSpan}"
                                         Grid.ColumnSpan="{Binding OrderPanelColumnSpan}"
                                         Spacing="{Binding StackSpacing}"
                                         VerticalOptions="Start"
                                         IsVisible="{Binding Order.ShowOrderForm}">

                        <!-- маршрут -->
                        <Border Style="{StaticResource Card}" Padding="{Binding CardPadding}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Маршрут" Style="{StaticResource CardTitle}" />

                                <!-- Откуда -->
                                <Border Style="{StaticResource AddressRow}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0" Style="{StaticResource AddressMarker}"
                                                VerticalOptions="Start" Margin="0,6,0,0">
                                            <Label Text="А" HorizontalOptions="Center" VerticalOptions="Center"
                                                   FontAttributes="Bold" TextColor="{StaticResource BrandOrange}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Entry Placeholder="Откуда: улица, дом"
                                                   Text="{Binding Order.FromQuery}" />

                                            <ScrollView MaximumHeightRequest="160"
                                                        VerticalScrollBarVisibility="Never"
                                                        IsVisible="{Binding Order.HasFromSuggestions}">
                                                <VerticalStackLayout Spacing="2"
                                                                     BindableLayout.ItemsSource="{Binding Order.FromSuggestions}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="8,6" BackgroundColor="{StaticResource PageBackground}">
                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}, Mode=FindAncestorBindingContext}, Path=Order.SelectFromCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                                </Grid.GestureRecognizers>
                                                                <Label Text="{Binding DisplayName}" Style="{StaticResource MutedLabel}"
                                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </ScrollView>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Order.FromPointStatus}" Style="{StaticResource MutedLabel}"
                                       IsVisible="{Binding Order.FromPointStatus, Converter={StaticResource IsNotEmptyConverter}}" />

                                <!-- Куда -->
                                <Border Style="{StaticResource AddressRow}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0" Style="{StaticResource AddressMarker}"
                                                VerticalOptions="Start" Margin="0,6,0,0">
                                            <Label Text="Б" HorizontalOptions="Center" VerticalOptions="Center"
                                                   FontAttributes="Bold" TextColor="{StaticResource BrandOrange}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Entry Placeholder="Куда: улица, дом"
                                                   Text="{Binding Order.ToQuery}" />

                                            <ScrollView MaximumHeightRequest="160"
                                                        VerticalScrollBarVisibility="Never"
                                                        IsVisible="{Binding Order.HasToSuggestions}">
                                                <VerticalStackLayout Spacing="2"
                                                                     BindableLayout.ItemsSource="{Binding Order.ToSuggestions}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="8,6" BackgroundColor="{StaticResource PageBackground}">
                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}, Mode=FindAncestorBindingContext}, Path=Order.SelectToCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                                </Grid.GestureRecognizers>
                                                                <Label Text="{Binding DisplayName}" Style="{StaticResource MutedLabel}"
                                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </ScrollView>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Order.ToPointStatus}" Style="{StaticResource MutedLabel}"
                                       IsVisible="{Binding Order.ToPointStatus, Converter={StaticResource IsNotEmptyConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- тариф -->
                        <Border Style="{StaticResource Card}" Padding="{Binding CardPadding}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Тариф" Style="{StaticResource CardTitle}" />

                                <FlexLayout BindableLayout.ItemsSource="{Binding Order.TariffOptions}"
                                            Wrap="NoWrap" AlignItems="Stretch">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Button Text="{Binding DisplayName}"
                                                    Command="{Binding SelectCommand}"
                                                    Style="{StaticResource TariffButton}"
                                                    FlexLayout.Grow="1" FlexLayout.Basis="0"
                                                    Margin="0,0,6,0">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor"
                                                                Value="{StaticResource BrandOrange}" />
                                                        <Setter Property="TextColor"
                                                                Value="{StaticResource White}" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <Label Text="{Binding Order.SelectedTariffDetails}"
                                       Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- стоимость -->
                        <Border Style="{StaticResource Card}" Padding="{Binding CardPadding}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="Стоимость поездки"
                                           Style="{StaticResource BodyText}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Order.EstimateText}"
                                           Style="{StaticResource PriceText}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*">
                                    <Label Grid.Column="0"
                                           Text="{Binding Order.DistanceText, StringFormat='Расстояние: {0}'}"
                                           Style="{StaticResource MutedLabel}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Order.DurationText, StringFormat='Время: {0}'}"
                                           Style="{StaticResource MutedLabel}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="Оформить заказ"
                                Command="{Binding Order.CreateCommand}"
                                IsEnabled="{Binding Order.CanCreate}"
                                Style="{StaticResource PrimaryButton}" />

                        <ActivityIndicator IsVisible="{Binding Order.IsBusy}"
                                           IsRunning="{Binding Order.IsBusy}" />
                    </VerticalStackLayout>

                    <!-- текущая поездка -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="{Binding OrderPanelColumn}"
                                         Grid.RowSpan="{Binding OrderPanelRowSpan}"
                                         Grid.ColumnSpan="{Binding OrderPanelColumnSpan}"
                                         Spacing="{Binding StackSpacing}"
                                         VerticalOptions="Start"
                                         IsVisible="{Binding Order.HasActiveTrip}">
                        <Border Style="{StaticResource Card}" Padding="{Binding CardPadding}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Текущая поездка" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding Order.ActiveStatusText}" FontSize="16"
                                       FontAttributes="Bold" TextColor="{StaticResource BrandOrange}" />
                                <Label Text="{Binding Order.ActiveTariffText}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Order.ActiveRoute}" Style="{StaticResource BodyText}" />

                                <BoxView HeightRequest="1" Color="{StaticResource StrokeColor}" />

                                <Label Text="{Binding Order.ActiveDriver}" Style="{StaticResource BodyText}" />
                                <Label Text="{Binding Order.ActiveVehicle}" Style="{StaticResource MutedLabel}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="К оплате" Style="{StaticResource BodyText}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Order.ActiveCost}"
                                           Style="{StaticResource PriceText}" FontSize="20" />
                                </Grid>
                                <Label Text="{Binding Order.RatingText}" Style="{StaticResource MutedLabel}"
                                       IsVisible="{Binding Order.RatingText, Converter={StaticResource IsNotEmptyConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="Найти водителя"
                                IsVisible="{Binding Order.CanSearchDriver}"
                                Command="{Binding Order.SearchDriverCommand}"
                                Style="{StaticResource PrimaryButton}" />

                        <Button Text="{Binding Order.AdvanceLabel}"
                                IsVisible="{Binding Order.CanAdvance}"
                                Command="{Binding Order.AdvanceCommand}"
                                Style="{StaticResource PrimaryButton}" />

                        <Button Text="Отменить поездку"
                                IsVisible="{Binding Order.CanCancel}"
                                Command="{Binding Order.CancelCommand}"
                                Style="{StaticResource SecondaryButton}" />

                        <Border Style="{StaticResource Card}" Padding="{Binding CardPadding}" IsVisible="{Binding Order.CanRate}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Оцените водителя" Style="{StaticResource CardTitle}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="1" Command="{Binding Order.RateCommand}" CommandParameter="1" Style="{StaticResource SecondaryButton}" WidthRequest="52" />
                                    <Button Text="2" Command="{Binding Order.RateCommand}" CommandParameter="2" Style="{StaticResource SecondaryButton}" WidthRequest="52" />
                                    <Button Text="3" Command="{Binding Order.RateCommand}" CommandParameter="3" Style="{StaticResource SecondaryButton}" WidthRequest="52" />
                                    <Button Text="4" Command="{Binding Order.RateCommand}" CommandParameter="4" Style="{StaticResource SecondaryButton}" WidthRequest="52" />
                                    <Button Text="5" Command="{Binding Order.RateCommand}" CommandParameter="5" Style="{StaticResource SecondaryButton}" WidthRequest="52" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <ActivityIndicator IsVisible="{Binding Order.IsBusy}"
                                           IsRunning="{Binding Order.IsBusy}" />
                    </VerticalStackLayout>
                </Grid>

                <Label Grid.Row="2" Text="{Binding Order.Message}"
                       TextColor="{StaticResource BrandBlue}"
                       IsVisible="{Binding Order.Message, Converter={StaticResource IsNotEmptyConverter}}" />
            </Grid>

            <!-- раздел «Профиль» -->
            <ScrollView IsVisible="{Binding ShowProfile}">
                <VerticalStackLayout Margin="{Binding ContentMargin}" Spacing="16">
                    <Label Text="Профиль" Style="{StaticResource SectionTitle}" />

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Profile.Passenger.FullName}" FontSize="18"
                                   FontAttributes="Bold" TextColor="{StaticResource BrandDark}" />
                            <Label Text="{Binding Profile.PhoneText}" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding Profile.Passenger.TripsCount, StringFormat='Поездок всего: {0}'}"
                                   Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="История поездок" Style="{StaticResource CardTitle}" />

                    <Label Text="Поездок пока нет."
                           Style="{StaticResource MutedLabel}"
                           IsVisible="{Binding Profile.HasHistory, Converter={StaticResource InvertedBoolConverter}}" />

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Profile.History}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Route}" FontAttributes="Bold"
                                               TextColor="{StaticResource BrandDark}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource MutedLabel}" />
                                        <Label Text="{Binding DriverText}" Style="{StaticResource BodyText}" FontSize="13" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource BodyText}" />
                                            <Label Grid.Column="1" Text="{Binding CostText}" FontAttributes="Bold"
                                                   TextColor="{StaticResource BrandDark}" />
                                        </Grid>
                                        <Label Text="{Binding RatingText}" Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding Profile.StatusMessage}"
                           TextColor="{StaticResource BrandBlue}"
                           IsVisible="{Binding Profile.StatusMessage, Converter={StaticResource IsNotEmptyConverter}}" />

                    <Button Text="Выйти из аккаунта"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- раздел «Настройки» -->
            <ScrollView IsVisible="{Binding ShowSettings}">
                <VerticalStackLayout Margin="{Binding ContentMargin}" Spacing="16">
                    <Label Text="Настройки" Style="{StaticResource SectionTitle}" />

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Settings.ApplicationName}" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource BrandDark}" />
                            <Label Text="{Binding Settings.Description}" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding Settings.Version}" Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Источник данных" Style="{StaticResource CardTitle}" />
                            <Label Text="{Binding Settings.DatabaseInfo}" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding Settings.ConnectionStatus}" Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Проверить подключение"
                            Command="{Binding Settings.CheckConnectionCommand}"
                            Style="{StaticResource SecondaryButton}" />

                    <Button Text="Выйти из аккаунта"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- нижняя навигация -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Padding="12,8" ColumnSpacing="8"
              BackgroundColor="{StaticResource HeaderBackground}">
            <Button Grid.Column="0" Text="Настройки" Style="{StaticResource NavButton}"
                    Command="{Binding ShowSettingsCommand}" />
            <Button Grid.Column="1" Text="Заказать" Style="{StaticResource NavButton}"
                    Command="{Binding ShowOrderCommand}"
                    TextColor="{StaticResource BrandOrange}" FontAttributes="Bold" />
            <Button Grid.Column="2" Text="Профиль" Style="{StaticResource NavButton}"
                    Command="{Binding ShowProfileCommand}" />
        </Grid>
        <BoxView Grid.Row="2" VerticalOptions="Start" HeightRequest="1"
                 Color="{StaticResource StrokeColor}" />
    </Grid>

</ContentPage>
