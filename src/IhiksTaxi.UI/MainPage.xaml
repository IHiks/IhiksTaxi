<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:IhiksTaxi.UI"
             x:Class="IhiksTaxi.UI.MainPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- фоновые геометрические фигуры -->
        <GraphicsView Grid.RowSpan="3" Drawable="{StaticResource BackgroundDecor}" InputTransparent="True" />

        <!-- верхняя плашка: она же заголовок окна, поэтому несёт кнопки окна -->
        <Grid x:Name="AppHeader" Grid.Row="0" Padding="16,0" HeightRequest="54"
              BackgroundColor="{AppThemeBinding Light={StaticResource HeaderBackground}, Dark={StaticResource HeaderBackgroundDark}}">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnHeaderPanUpdated" />
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnHeaderDoubleTapped" />
            </Grid.GestureRecognizers>
            <HorizontalStackLayout HorizontalOptions="Start" VerticalOptions="Center" Spacing="6">
                <Label Text="IHIKS" Style="{StaticResource LogoOrange}" />
                <Label Text="ТАКСИ" Style="{StaticResource LogoDark}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                <Button x:Name="MinimizeButton" Text="&#xE921;" Style="{StaticResource WindowButton}"
                        Clicked="OnMinimizeClicked" ToolTipProperties.Text="Свернуть" />
                <Button x:Name="MaximizeButton" Text="&#xE922;" Style="{StaticResource WindowButton}"
                        Clicked="OnMaximizeClicked" ToolTipProperties.Text="Развернуть" />
                <Button x:Name="CloseButton" Text="&#xE8BB;" Style="{StaticResource WindowCloseButton}"
                        Clicked="OnCloseClicked" ToolTipProperties.Text="Закрыть" />
            </HorizontalStackLayout>
        </Grid>
        <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1"
                 Color="{AppThemeBinding Light={StaticResource StrokeColor}, Dark={StaticResource StrokeColorDark}}" />

        <!-- рабочая область -->
        <Grid Grid.Row="1">

            <!-- раздел «Заказать» -->
            <Grid IsVisible="{Binding ShowOrder}"
                  Margin="{Binding ContentMargin}"
                  RowDefinitions="Auto,*,Auto" RowSpacing="12">

                <Label Grid.Row="0" Text="Заказать поездку" Style="{StaticResource SectionTitle}" />

                <Grid Grid.Row="1" RowDefinitions="Auto,*"
                      ColumnSpacing="{Binding OrderColumnSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding OrderPanelColumnWidth}" />
                    </Grid.ColumnDefinitions>

                    <!-- карта видна всё время работы с заказом -->
                    <Border Grid.Row="{Binding OrderMapRow}"
                            Grid.Column="{Binding OrderMapColumn}"
                            Grid.RowSpan="{Binding OrderMapRowSpan}"
                            Grid.ColumnSpan="{Binding OrderMapColumnSpan}"
                            Style="{StaticResource Card}" Padding="0"
                            VerticalOptions="Fill"
                            IsVisible="{Binding Order.HasMap}">
                        <Grid>
                            <WebView x:Name="MapWebView" Source="{Binding Order.MapSource}"
                                     HorizontalOptions="Fill" VerticalOptions="Fill" />
                            <Border Margin="12" Padding="8,6"
                                    HorizontalOptions="Start" VerticalOptions="End"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftBlue}, Dark={StaticResource SoftBlueDark}}" Stroke="{AppThemeBinding Light={StaticResource StrokeColor}, Dark={StaticResource StrokeColorDark}}"
                                    StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                    IsVisible="{Binding Order.MapNote, Converter={StaticResource IsNotEmptyConverter}}">
                                <Label Text="{Binding Order.MapNote}" Style="{StaticResource MutedLabel}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- форма заказа -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="{Binding OrderPanelColumn}"
                                         Grid.RowSpan="{Binding OrderPanelRowSpan}"
                                         Grid.ColumnSpan="{Binding OrderPanelColumnSpan}"
                                         Spacing="{Binding StackSpacing}"
                                         VerticalOptions="Start"
                                         IsVisible="{Binding Order.ShowOrderForm}">

                        <VerticalStackLayout Spacing="8">
                                <Label Text="Куда поедем?" Style="{StaticResource CardTitle}" />

                                <!-- Откуда -->
                                <Border Style="{StaticResource AddressRow}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0" Style="{StaticResource AddressMarker}"
                                                VerticalOptions="Start" Margin="0,6,0,0">
                                            <Label Text="A" HorizontalOptions="Center" VerticalOptions="Center"
                                                   FontAttributes="Bold" TextColor="{StaticResource BrandOrange}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Entry Placeholder="Откуда: улица, дом"
                                                   Text="{Binding Order.FromQuery}" />

                                            <ScrollView MaximumHeightRequest="160"
                                                        VerticalScrollBarVisibility="Never"
                                                        IsVisible="{Binding Order.HasFromSuggestions}">
                                                <VerticalStackLayout Spacing="2"
                                                                     BindableLayout.ItemsSource="{Binding Order.FromSuggestions}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="8,6" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}, Mode=FindAncestorBindingContext}, Path=Order.SelectFromCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                                </Grid.GestureRecognizers>
                                                                <Label Text="{Binding DisplayName}" Style="{StaticResource MutedLabel}"
                                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </ScrollView>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Order.FromPointStatus}" Style="{StaticResource MutedLabel}"
                                       IsVisible="{Binding Order.FromPointStatus, Converter={StaticResource IsNotEmptyConverter}}" />

                                <!-- Куда -->
                                <Border Style="{StaticResource AddressRow}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Grid.Column="0" Style="{StaticResource AddressMarker}"
                                                VerticalOptions="Start" Margin="0,6,0,0">
                                            <Label Text="Б" HorizontalOptions="Center" VerticalOptions="Center"
                                                   FontAttributes="Bold" TextColor="{StaticResource BrandOrange}" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Entry Placeholder="Куда: улица, дом"
                                                   Text="{Binding Order.ToQuery}" />

                                            <ScrollView MaximumHeightRequest="160"
                                                        VerticalScrollBarVisibility="Never"
                                                        IsVisible="{Binding Order.HasToSuggestions}">
                                                <VerticalStackLayout Spacing="2"
                                                                     BindableLayout.ItemsSource="{Binding Order.ToSuggestions}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="8,6" BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}, Mode=FindAncestorBindingContext}, Path=Order.SelectToCommand}"
                                                                        CommandParameter="{Binding .}" />
                                                                </Grid.GestureRecognizers>
                                                                <Label Text="{Binding DisplayName}" Style="{StaticResource MutedLabel}"
                                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </ScrollView>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <Label Text="{Binding Order.ToPointStatus}" Style="{StaticResource MutedLabel}"
                                       IsVisible="{Binding Order.ToPointStatus, Converter={StaticResource IsNotEmptyConverter}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Выберите тариф" Style="{StaticResource CardTitle}" />
                                    <Label Grid.Column="1" Text="Базовая ставка" Style="{StaticResource MutedLabel}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8"
                                      BindableLayout.ItemsSource="{Binding Order.TariffOptions}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Grid.Column="{Binding Column}" Grid.ColumnDefinitions="*">
                                                <Border Style="{StaticResource TariffTile}">
                                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center"
                                                                         VerticalOptions="Center">
                                                        <Label Text="{Binding DisplayName}" Style="{StaticResource TariffName}" />
                                                        <Label Text="{Binding BaseCostText}" Style="{StaticResource TariffBaseCost}" />
                                                    </VerticalStackLayout>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border"
                                                                     Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TileSelected}, Dark={StaticResource TileSelectedDark}}" />
                                                            <Setter Property="Stroke" Value="{StaticResource BrandOrange}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                                <Button Text=""
                                                        Command="{Binding SelectCommand}"
                                                        Style="{StaticResource TariffHit}" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </Grid>

                        </VerticalStackLayout>

                        <Border Style="{StaticResource EstimatePanel}">
                            <Grid ColumnDefinitions="*,1,*">
                                <VerticalStackLayout Grid.Column="0" Padding="14,12" Spacing="2">
                                    <Label Text="ВРЕМЯ В ПУТИ" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding Order.DurationText}" Style="{StaticResource BodyText}"
                                           FontSize="20" FontAttributes="Bold" />
                                    <Label Text="{Binding Order.DistanceText}" Style="{StaticResource MutedLabel}" />
                                </VerticalStackLayout>
                                <BoxView Grid.Column="1" Color="{AppThemeBinding Light={StaticResource TileBorder}, Dark={StaticResource TileBorderDark}}" />
                                <VerticalStackLayout Grid.Column="2" Padding="14,12" Spacing="2">
                                    <Label Text="ОЦЕНКА СТОИМОСТИ" Style="{StaticResource FieldLabel}" />
                                    <Label Text="{Binding Order.EstimateText}" Style="{StaticResource PriceText}" />
                                    <Label Text="{Binding Order.SelectedTariffDetails}" Style="{StaticResource MutedLabel}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Button Text="Заказать поездку"
                                Command="{Binding Order.CreateCommand}"
                                IsEnabled="{Binding Order.CanCreate}"
                                Style="{StaticResource PrimaryButton}" />

                        <ActivityIndicator IsVisible="{Binding Order.IsBusy}"
                                           IsRunning="{Binding Order.IsBusy}" />
                    </VerticalStackLayout>

                    <!-- текущая поездка -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="{Binding OrderPanelColumn}"
                                         Grid.RowSpan="{Binding OrderPanelRowSpan}"
                                         Grid.ColumnSpan="{Binding OrderPanelColumnSpan}"
                                         Spacing="{Binding StackSpacing}"
                                         VerticalOptions="Start"
                                         IsVisible="{Binding Order.HasActiveTrip}">
                        <Border Style="{StaticResource ActiveTripPanel}" Padding="16">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="{Binding Order.ActiveStatusText}" FontSize="20"
                                       FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="{Binding Order.ActiveTariffText}" Style="{StaticResource MutedLabel}" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"
                                      IsVisible="{Binding Order.HasDriver}">
                                    <Border Grid.Column="0" Style="{StaticResource DriverAvatar}">
                                        <Label Text="{Binding Order.ActiveDriverInitials}" FontSize="18"
                                               FontAttributes="Bold" TextColor="{StaticResource BrandOrange}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Order.ActiveDriverName}" FontSize="16"
                                               FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding Order.ActiveDriverPhone}" Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource OrangeSurface}, Dark={StaticResource OrangeSurfaceDark}}"
                                        Stroke="{AppThemeBinding Light={StaticResource TileBorder}, Dark={StaticResource TileBorderDark}}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12" Padding="14,12"
                                        IsVisible="{Binding Order.HasDriver}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Grid.Column="0" WidthRequest="34" HeightRequest="34"
                                                Stroke="{AppThemeBinding Light={StaticResource ColorDotBorder}, Dark={StaticResource ColorDotBorderDark}}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 17"
                                                BackgroundColor="{Binding Order.ActiveVehicleColorSwatch}"
                                                VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Order.ActiveVehiclePlate}"
                                                   Style="{StaticResource VehiclePlate}" />
                                            <Label Text="{Binding Order.ActiveVehicleColor, StringFormat='Цвет: {0}'}"
                                                   Style="{StaticResource MutedLabel}" />
                                            <Label Text="{Binding Order.ActiveVehicleName}" Style="{StaticResource MutedLabel}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="Маршрут" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Order.ActiveRoute}" Style="{StaticResource BodyText}"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource TileBorder}, Dark={StaticResource TileBorderDark}}" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="К оплате" Style="{StaticResource BodyText}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Order.ActiveCost}"
                                           Style="{StaticResource PriceText}" />
                                </Grid>
                                <Label Text="{Binding Order.RatingText}" Style="{StaticResource MutedLabel}"
                                       IsVisible="{Binding Order.RatingText, Converter={StaticResource IsNotEmptyConverter}}" />
                            </VerticalStackLayout>
                        </Border>

                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding Order.IsBusy}">
                            <ActivityIndicator IsRunning="{Binding Order.IsBusy}" />
                            <Label Text="Выполняется операция…" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Button Text="Найти водителя"
                                IsVisible="{Binding Order.CanSearchDriver}"
                                Command="{Binding Order.SearchDriverCommand}"
                                Style="{StaticResource PrimaryButton}" />

                        <Button Text="{Binding Order.AdvanceLabel}"
                                IsVisible="{Binding Order.CanAdvance}"
                                Command="{Binding Order.AdvanceCommand}"
                                Style="{StaticResource PrimaryButton}" />

                        <Button Text="Отменить поездку"
                                IsVisible="{Binding Order.CanCancel}"
                                Command="{Binding Order.CancelCommand}"
                                Style="{StaticResource DestructiveButton}" />

                        <Border Style="{StaticResource RatingPanel}" IsVisible="{Binding Order.CanRate}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Оцените водителя" Style="{StaticResource CardTitle}"
                                       TextColor="{StaticResource BrandOrange}" />
                                <Label Text="Оценка сохранится сразу после выбора."
                                       Style="{StaticResource MutedLabel}" TextColor="{AppThemeBinding Light={StaticResource SoftOrange}, Dark={StaticResource AccentLight}}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Button Text="1" Command="{Binding Order.RateCommand}" CommandParameter="1" Style="{StaticResource RatingButton}" />
                                    <Button Text="2" Command="{Binding Order.RateCommand}" CommandParameter="2" Style="{StaticResource RatingButton}" />
                                    <Button Text="3" Command="{Binding Order.RateCommand}" CommandParameter="3" Style="{StaticResource RatingButton}" />
                                    <Button Text="4" Command="{Binding Order.RateCommand}" CommandParameter="4" Style="{StaticResource RatingButton}" />
                                    <Button Text="5" Command="{Binding Order.RateCommand}" CommandParameter="5" Style="{StaticResource RatingButton}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <ActivityIndicator IsVisible="{Binding Order.IsBusy}"
                                           IsRunning="{Binding Order.IsBusy}" />
                    </VerticalStackLayout>
                </Grid>

                <Label Grid.Row="2" Text="{Binding Order.Message}"
                       TextColor="{AppThemeBinding Light={StaticResource BrandBlue}, Dark=#9CC0DC}"
                       IsVisible="{Binding Order.Message, Converter={StaticResource IsNotEmptyConverter}}" />
            </Grid>

            <!-- раздел «Профиль» -->
            <ScrollView IsVisible="{Binding ShowProfile}">
                <VerticalStackLayout Margin="{Binding ContentMargin}" Spacing="18">
                    <Label Text="Профиль" Style="{StaticResource SectionTitle}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource ProfileAvatar}">
                            <Label Text="{Binding Profile.Passenger.FullName, StringFormat='{0}'}"
                                   FontSize="20" FontAttributes="Bold" TextColor="{StaticResource ActionOrange}"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" MaxLines="1" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Profile.Passenger.FullName}" FontSize="18"
                                   FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label Text="{Binding Profile.PhoneText}" Style="{StaticResource MutedLabel}" />
                            <Label Text="{Binding Profile.Passenger.TripsCount, StringFormat='Поездок всего: {0}'}"
                                   Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="История поездок" Style="{StaticResource CardTitle}" VerticalOptions="Center" />
                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding Profile.IsBusy}"
                                           IsVisible="{Binding Profile.IsBusy}" />
                    </Grid>

                    <Border Style="{StaticResource InfoPanel}" IsVisible="{Binding Profile.HasError, Converter={StaticResource IsNotEmptyConverter}}">
                        <Label Text="{Binding Profile.StatusMessage}" TextColor="{AppThemeBinding Light={StaticResource ErrorText}, Dark={StaticResource ErrorTextDark}}" />
                    </Border>

                    <Label Text="Здесь появятся завершённые и отменённые поездки."
                           Style="{StaticResource MutedLabel}"
                           IsVisible="{Binding Profile.HasHistory, Converter={StaticResource InvertedBoolConverter}}" />

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Profile.History}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource HistoryPanel}">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Route}" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                               LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding CostText}" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Start"
                                               Margin="8,0,0,0" />
                                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding DateText}" Style="{StaticResource MutedLabel}" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}"
                                               TextColor="{Binding StatusColor}" FontAttributes="Bold"
                                               HorizontalOptions="End" />
                                        <Label Grid.Row="2" Grid.Column="0" Text="{Binding DriverText}" Style="{StaticResource MutedLabel}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding RatingText}" Style="{StaticResource MutedLabel}"
                                               HorizontalOptions="End" Margin="8,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Выйти из аккаунта"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- раздел «Настройки» -->
            <ScrollView IsVisible="{Binding ShowSettings}">
                <VerticalStackLayout Margin="{Binding ContentMargin}" Spacing="18">
                    <Label Text="Настройки" Style="{StaticResource SectionTitle}" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="О ПРИЛОЖЕНИИ" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource HistoryPanel}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Settings.ApplicationName}" FontSize="18" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="{Binding Settings.Description}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Settings.Version}" Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="ТЕМА ОФОРМЛЕНИЯ" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource SegmentedControl}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Button Text="Светлая"
                                        Command="{Binding Settings.UseLightThemeCommand}"
                                        Style="{StaticResource SegmentButton}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding Settings.UseLightTheme}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource ActionOrange}" />
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="1" Text="Тёмная"
                                        Command="{Binding Settings.UseDarkThemeCommand}"
                                        Style="{StaticResource SegmentButton}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding Settings.UseDarkTheme}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource ActionOrange}" />
                                            <Setter Property="TextColor" Value="{StaticResource White}" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="ПОДКЛЮЧЕНИЕ К ДАННЫМ" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource HistoryPanel}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="PostgreSQL" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                <Label Text="{Binding Settings.DatabaseInfo}" Style="{StaticResource MutedLabel}" />
                                <Label Text="{Binding Settings.StatusText}" Style="{StaticResource MutedLabel}"
                                       TextColor="{Binding Settings.StatusColor}" />
                            </VerticalStackLayout>
                        </Border>
                        <Button Text="Проверить подключение"
                                Command="{Binding Settings.CheckConnectionCommand}"
                                IsEnabled="{Binding Settings.CanCheck}"
                                Style="{StaticResource SecondaryButton}" />
                        <HorizontalStackLayout Spacing="8" IsVisible="{Binding Settings.IsBusy}">
                            <ActivityIndicator IsRunning="{Binding Settings.IsBusy}" />
                            <Label Text="Проверяем подключение…" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Button Text="Выйти из аккаунта"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- нижняя навигация -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Padding="12,8" ColumnSpacing="8"
              BackgroundColor="{AppThemeBinding Light={StaticResource HeaderBackground}, Dark={StaticResource HeaderBackgroundDark}}">
            <!-- цвета навигации ставит страница в коде (PaintNav): триггеры и
                 состояния MAUI не снимали цвет после щелчка, и неактивные
                 кнопки оставались с цветом активной вкладки -->
            <Button x:Name="NavSettingsButton" Grid.Column="0" Text="Настройки" Style="{StaticResource NavButton}"
                    Command="{Binding ShowSettingsCommand}" />
            <Button x:Name="NavOrderButton" Grid.Column="1" Text="Заказать" Style="{StaticResource NavButton}"
                    Command="{Binding ShowOrderCommand}" />
            <Button x:Name="NavProfileButton" Grid.Column="2" Text="Профиль" Style="{StaticResource NavButton}"
                    Command="{Binding ShowProfileCommand}" />
        </Grid>
        <BoxView Grid.Row="2" VerticalOptions="Start" HeightRequest="1"
                 Color="{AppThemeBinding Light={StaticResource StrokeColor}, Dark={StaticResource StrokeColorDark}}" />
    </Grid>

</ContentPage>
