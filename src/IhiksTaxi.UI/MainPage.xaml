<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:domain="clr-namespace:IhiksTaxi.Domain;assembly=IhiksTaxi.Domain"
             x:Class="IhiksTaxi.UI.MainPage">

    <!-- резиновый дизайн: две колонки *, прижатые к краям -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
          ColumnDefinitions="*,*"
          Padding="20"
          RowSpacing="14"
          ColumnSpacing="14">

        <Label Grid.Row="0" Grid.ColumnSpan="2"
               Text="IHIKS Taxi"
               Style="{StaticResource Headline}"
               SemanticProperties.HeadingLevel="Level1" />

        <Border Grid.Row="1" Grid.Column="0" Padding="12" StrokeShape="RoundRectangle 8">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding DriversCount, StringFormat='Водителей в базе: {0}'}" />
                <Label Text="{Binding TripsCount, StringFormat='Поездок в базе: {0}'}" />
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Padding="12" StrokeShape="RoundRectangle 8">
            <Label x:Name="StatusLabel"
                   Text="{Binding StatusMessage}"
                   VerticalOptions="Center" />
        </Border>

        <Label Grid.Row="2" Grid.ColumnSpan="2"
               Text="Тарифы (справочник классов)"
               Style="{StaticResource SubHeadline}" />

        <Button Grid.Row="3" Grid.ColumnSpan="2"
                Text="Обновить"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

        <!-- привязка ItemsSource к тарифам из БД -->
        <CollectionView Grid.Row="4" Grid.ColumnSpan="2"
                        ItemsSource="{Binding Tariffs}">
            <CollectionView.Header>
                <Grid ColumnDefinitions="*,*,*,*" Padding="6,4" ColumnSpacing="6">
                    <Label Grid.Column="0" Text="Класс" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="Подача" FontAttributes="Bold" />
                    <Label Grid.Column="2" Text="За км" FontAttributes="Bold" />
                    <Label Grid.Column="3" Text="За мин" FontAttributes="Bold" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="domain:Tariff">
                    <Grid ColumnDefinitions="*,*,*,*" Padding="6,4" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="{Binding Name}" />
                        <Label Grid.Column="1" Text="{Binding BaseCost, StringFormat='{0:0.##} ₽'}" />
                        <Label Grid.Column="2" Text="{Binding RatePerKm, StringFormat='{0:0.##} ₽'}" />
                        <Label Grid.Column="3" Text="{Binding RatePerMinute, StringFormat='{0:0.##} ₽'}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
