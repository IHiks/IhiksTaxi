<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#FF8000</Color>
    <Color x:Key="PrimaryDark">#E67300</Color>
    <Color x:Key="PrimaryDarkText">#102A43</Color>
    <Color x:Key="Secondary">#EAF2F8</Color>
    <Color x:Key="SecondaryDarkText">#102A43</Color>
    <Color x:Key="Tertiary">#102A43</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#486581</Color>
    <Color x:Key="MidnightBlue">#102A43</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <!-- фирменные цвета IHIKS Taxi -->
    <Color x:Key="BrandOrange">#FF8000</Color>
    <Color x:Key="ActionOrange">#FF8000</Color>
    <Color x:Key="ActionOrangeHover">#F27300</Color>
    <Color x:Key="ActionOrangePressed">#E06600</Color>
    <Color x:Key="BrandDark">#102A43</Color>
    <Color x:Key="BrandBlue">#486581</Color>
    <Color x:Key="SoftBlue">#EAF2F8</Color>
    <Color x:Key="PageBackground">#F7F9FC</Color>
    <Color x:Key="HeaderBackground">#FFFFFF</Color>
    <Color x:Key="MutedText">#486581</Color>
    <Color x:Key="TertiaryText">#627D98</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="StrokeColor">#D9E2EC</Color>
    <Color x:Key="SurfaceMuted">#EAF2F8</Color>
    <Color x:Key="SurfaceWarm">#FFF1E5</Color>
    <Color x:Key="FocusRing">#FFB266</Color>
    <Color x:Key="FocusColor">#FF8A00</Color>
    <Color x:Key="SoftOrange">#E08A3C</Color>
    <Color x:Key="OrangeSurface">#FFF6EE</Color>
    <Color x:Key="TileBorder">#DCE3EA</Color>
    <Color x:Key="ColorDotBorder">#D6DEE7</Color>
    <Color x:Key="DisabledBackground">#E6ECF2</Color>
    <Color x:Key="DisabledText">#526D82</Color>
    <Color x:Key="SuccessText">#1F7A4C</Color>
    <Color x:Key="SuccessBackground">#EAF7F0</Color>
    <Color x:Key="WarningText">#8A4B00</Color>
    <Color x:Key="WarningBackground">#FFF4E5</Color>
    <Color x:Key="ErrorText">#B42318</Color>
    <Color x:Key="ErrorBackground">#FDECEC</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
