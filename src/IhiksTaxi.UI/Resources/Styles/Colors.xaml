<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Палитра IHIKS Taxi:
         оранжевый #FF911F, светло-оранжевый #FFD2A6,
         почти чёрный #191A17, тёмно-синий #163E5B.
         Для каждого смыслового цвета есть пара: светлая тема и ...Dark. -->

    <!-- фирменные цвета -->
    <Color x:Key="AccentOrange">#FF911F</Color>
    <Color x:Key="AccentLight">#FFD2A6</Color>
    <Color x:Key="Ink">#191A17</Color>
    <Color x:Key="DeepBlue">#163E5B</Color>

    <Color x:Key="BrandOrange">#FF911F</Color>
    <Color x:Key="ActionOrange">#FF911F</Color>
    <Color x:Key="ActionOrangeHover">#E8820F</Color>
    <Color x:Key="ActionOrangePressed">#CF730C</Color>
    <Color x:Key="BrandDark">#191A17</Color>
    <Color x:Key="BrandBlue">#163E5B</Color>
    <Color x:Key="SoftOrange">#B36A1A</Color>
    <Color x:Key="FocusRing">#FFC48A</Color>
    <Color x:Key="FocusRingDark">#8A5A2B</Color>
    <Color x:Key="FocusColor">#FF911F</Color>

    <!-- текст -->
    <Color x:Key="TextPrimary">#191A17</Color>
    <Color x:Key="TextPrimaryDark">#E7EDF2</Color>
    <Color x:Key="MutedText">#4B5A66</Color>
    <Color x:Key="MutedTextDark">#9BAAB8</Color>
    <Color x:Key="TertiaryText">#7C8A94</Color>
    <Color x:Key="TertiaryTextDark">#7C8B99</Color>

    <!-- поверхности: светлая тема -->
    <Color x:Key="PageBackground">#F7F7F5</Color>
    <Color x:Key="HeaderBackground">#FFFFFF</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#EFEFEC</Color>
    <Color x:Key="SurfaceWarm">#FFE9D2</Color>
    <Color x:Key="OrangeSurface">#FFF4EA</Color>
    <Color x:Key="StrokeColor">#E2E1DD</Color>
    <Color x:Key="TileBorder">#E4E3DF</Color>
    <Color x:Key="ColorDotBorder">#CFCFC9</Color>
    <Color x:Key="SoftBlue">#E8EEF3</Color>
    <Color x:Key="DisabledBackground">#E8E8E4</Color>
    <Color x:Key="DisabledText">#7A8A94</Color>

    <!-- поверхности: тёмная тема, тёмно-синяя вместо белой -->
    <Color x:Key="PageBackgroundDark">#0F1A22</Color>
    <Color x:Key="HeaderBackgroundDark">#142430</Color>
    <Color x:Key="CardBackgroundDark">#182734</Color>
    <Color x:Key="SurfaceMutedDark">#21303C</Color>
    <Color x:Key="SurfaceWarmDark">#3A2E1E</Color>
    <Color x:Key="OrangeSurfaceDark">#2E2519</Color>
    <Color x:Key="StrokeColorDark">#2A3A47</Color>
    <Color x:Key="TileBorderDark">#26343F</Color>
    <Color x:Key="TileSelected">#FFFFFF</Color>
    <Color x:Key="TileSelectedDark">#2E4250</Color>
    <Color x:Key="ColorDotBorderDark">#3A4A56</Color>
    <Color x:Key="SoftBlueDark">#1E2E3A</Color>
    <Color x:Key="DisabledBackgroundDark">#232D36</Color>
    <Color x:Key="DisabledTextDark">#6C7A87</Color>

    <!-- статусы -->
    <Color x:Key="SuccessText">#1F7A4C</Color>
    <Color x:Key="SuccessTextDark">#6FD3A2</Color>
    <Color x:Key="SuccessBackground">#EAF7F0</Color>
    <Color x:Key="SuccessBackgroundDark">#17352A</Color>
    <Color x:Key="WarningText">#8A4B00</Color>
    <Color x:Key="WarningTextDark">#E0B26A</Color>
    <Color x:Key="WarningBackground">#FFF4E5</Color>
    <Color x:Key="WarningBackgroundDark">#3A2A17</Color>
    <Color x:Key="ErrorText">#B42318</Color>
    <Color x:Key="ErrorTextDark">#F08C84</Color>
    <Color x:Key="ErrorBackground">#FDECEC</Color>
    <Color x:Key="ErrorBackgroundDark">#3A1F1F</Color>

    <!-- цвета шаблона MAUI -->
    <Color x:Key="Primary">#FF911F</Color>
    <Color x:Key="PrimaryDark">#E8820F</Color>
    <Color x:Key="PrimaryDarkText">#191A17</Color>
    <Color x:Key="Secondary">#E8EEF3</Color>
    <Color x:Key="SecondaryDarkText">#E7EDF2</Color>
    <Color x:Key="Tertiary">#163E5B</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#163E5B</Color>
    <Color x:Key="MidnightBlue">#163E5B</Color>
    <Color x:Key="OffBlack">#0F1A22</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>
